<?xml version="1.0" encoding="UTF-8"?>
<!--
    Integration tests run against the WordPress test library (wp-phpunit) and
    a real MySQL database that the bootstrap DROPS AND RECREATES tables in.
    Never point WP_TESTS_DB_NAME at a site database.

    Prerequisites:
      composer install && composer shell-update   (admin shell boots at plugins_loaded 5, needs vendor-prefixed/)
      CREATE DATABASE yaycheckout_tests;

    Overrides (env or a gitignored phpunit.xml copy of this file):
      WP_TESTS_DB_NAME      default yaycheckout_tests
      WP_TESTS_DB_USER      default root
      WP_TESTS_DB_PASSWORD  default empty
      WP_TESTS_DB_HOST      default localhost; Local (by Flywheel) sites need the per-site socket:
                            localhost:/Users/<you>/Library/Application Support/Local/run/<site-id>/mysql/mysqld.sock
      WP_TESTS_ABSPATH      default four directories up (the site's app/public/)
      WP_TESTS_DIR          default vendor/wp-phpunit/wp-phpunit
-->
<phpunit
    bootstrap="tests/bootstrap.php"
    colors="true"
    beStrictAboutTestsThatDoNotTestAnything="true"
    failOnWarning="true"
>
    <testsuites>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="WP_TESTS_DB_NAME" value="yaycheckout_tests"/>
        <env name="WP_TESTS_DB_USER" value="root"/>
        <env name="WP_TESTS_DB_PASSWORD" value=""/>
        <env name="WP_TESTS_DB_HOST" value="localhost"/>
    </php>
</phpunit>
