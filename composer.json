{
  "name": "yaycommerce/yaycheckout",
  "type": "wordpress-plugin",
  "require": {
    "yaycommerce/admin-shell": "^2.5"
  },
  "repositories": {
    "admin-shell": {
      "type": "vcs",
      "url": "https://github.com/YayCommerce/yaycommerce-plugin-admin-shell.git"
    }
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "humbug/php-scoper": "^0.18.18",
    "squizlabs/php_codesniffer": "^3.9",
    "thecodingmachine/safe": "^3.4",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "classmap": [
      "vendor-prefixed/src",
      "YayCheckoutPluginAdapter.php"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "shell-update": "yaycommerce-update",
    "check:boundary": "bash scripts/check-premium-boundary.sh",
    "lint": [
      "@check:boundary",
      "phpcs"
    ],
    "lint:fix": "phpcbf"
  }
}
