{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "yay-plugin-harness": {
      "source": {
        "source": "directory",
        "path": "/Users/shrief/yay-plugin-harness"
      }
    }
  },
  "enabledPlugins": {
    "yay@yay-plugin-harness": true
  },
  "permissions": {
    "allow": [
      "Bash(composer lint *)",
      "Bash(composer test)",
      "Bash(pnpm --filter @yaycheckout/admin-page lint)",
      "Bash(pnpm --filter @yaycheckout/admin-page exec tsc --noEmit)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(./scripts/run.sh backlog)",
      "Bash(./scripts/check-harness.sh)"
    ]
  },
  "includeGitInstructions": false
}
