{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "yayharness": {
      "source": {
        "source": "github",
        "repo": "thithiennta/yayharness-kit"
      }
    }
  },
  "enabledPlugins": {
    "yay@yayharness": true
  },
  "permissions": {
    "allow": [
      "Bash(yayh *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git worktree list *)",
      "Bash(composer lint *)",
      "Bash(composer test)",
      "Bash(pnpm --filter @yaycheckout/admin-page lint)",
      "Bash(pnpm --filter @yaycheckout/admin-page exec tsc --noEmit)",
      "Bash(./scripts/check-pro-boundary.sh)"
    ]
  },
  "includeGitInstructions": false
}
