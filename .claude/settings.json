{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(composer lint *)",
      "Bash(composer test)",
      "Bash(pnpm --filter @yaycheckout/admin-page lint)",
      "Bash(pnpm --filter @yaycheckout/admin-page exec tsc --noEmit)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(./scripts/run.sh backlog)",
      "Bash(./scripts/check-harness.sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-generated-paths.sh"
            ]
          }
        ]
      }
    ]
  },
  "includeGitInstructions": false
}
