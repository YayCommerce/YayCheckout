{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/shipping",
  "title": "Shipping",
  "category": "yaycheckout",
  "description": "Shipping address canvas. Fields, layout and text blocks can sit inside it.",
  "textdomain": "yaycheckout",
  "keywords": [ "address", "delivery" ],
  "example": {
    "innerBlocks": [
      {
        "name": "yaycheckout/field",
        "attributes": {
          "fieldKey": "shipping_first_name",
          "label": "First name"
        }
      },
      {
        "name": "yaycheckout/field",
        "attributes": {
          "fieldKey": "shipping_last_name",
          "label": "Last name"
        }
      }
    ]
  },
  "ancestor": [ "yaycheckout/checkout" ],
  "attributes": {
    "title": {
      "type": "string",
      "default": "Shipping"
    },
    "showTitle": {
      "type": "boolean",
      "default": true
    },
    "headingLevel": {
      "type": "number",
      "default": 3
    },
    "description": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false,
    "color": {
      "text": true,
      "background": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
