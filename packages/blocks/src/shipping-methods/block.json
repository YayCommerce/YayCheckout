{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/shipping-methods",
  "title": "Shipping Methods",
  "category": "yaycheckout",
  "description": "Shipping rate list. Classic checkout radios, not the shipping address form.",
  "textdomain": "yaycheckout",
  "keywords": [ "rates", "delivery" ],
  "example": {},
  "ancestor": [ "yaycheckout/checkout" ],
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "label": {
      "type": "string",
      "default": "Shipping methods"
    },
    "layout": {
      "type": "string",
      "default": "default"
    },
    "style": {
      "type": "object",
      "default": {}
    }
  },
  "supports": {
    "html": false,
    "yaycheckoutWatchable": true,
    "multiple": false,
    "reusable": false,
    "color": {
      "text": true,
      "background": false,
      "__experimentalSkipSerialization": true,
      "__experimentalDefaultControls": {
        "text": false
      }
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
