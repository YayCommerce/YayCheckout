{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/additional-fields",
  "title": "Additional fields",
  "category": "yaycheckout",
  "description": "WooCommerce's order fields, such as the order note and fields that plugins add, as WooCommerce defines them.",
  "textdomain": "yaycheckout",
  "keywords": [ "note", "additional", "order", "fields" ],
  "ancestor": [ "yaycheckout/checkout" ],
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false,
    "color": {
      "text": true,
      "background": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php"
}
