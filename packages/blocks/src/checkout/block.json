{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/checkout",
  "title": "Checkout",
  "category": "yaycheckout",
  "description": "Root container for a YayCheckout checkout layout.",
  "textdomain": "yaycheckout",
  "keywords": [ "woocommerce", "form" ],
  "example": {
    "innerBlocks": [
      {
        "name": "yaycheckout/contact"
      },
      {
        "name": "yaycheckout/billing",
        "innerBlocks": [
          {
            "name": "yaycheckout/field",
            "attributes": {
              "fieldKey": "billing_first_name",
              "label": "First name"
            }
          },
          {
            "name": "yaycheckout/field",
            "attributes": {
              "fieldKey": "billing_last_name",
              "label": "Last name"
            }
          }
        ]
      },
      {
        "name": "yaycheckout/payment"
      },
      {
        "name": "yaycheckout/place-order"
      }
    ]
  },
  "attributes": {
    "lock": {
      "type": "object",
      "default": { "remove": true }
    }
  },
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
