{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/checkout",
  "title": "Checkout",
  "category": "yaycheckout",
  "description": "Root container for a YayCheckout checkout layout.",
  "textdomain": "yaycheckout",
  "keywords": [ "woocommerce", "form" ],
  "example": {
    "innerBlocks": [
      {
        "name": "yaycheckout/email"
      },
      {
        "name": "yaycheckout/billing",
        "innerBlocks": [
          {
            "name": "yaycheckout/field",
            "attributes": {
              "fieldKey": "billing_first_name",
              "label": "First name"
            }
          },
          {
            "name": "yaycheckout/field",
            "attributes": {
              "fieldKey": "billing_last_name",
              "label": "Last name"
            }
          }
        ]
      },
      {
        "name": "yaycheckout/payment"
      },
      {
        "name": "yaycheckout/place-order",
        "attributes": {
          "buttonText": "Place order"
        }
      }
    ]
  },
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false,
    "color": {
      "text": true,
      "background": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php"
}
