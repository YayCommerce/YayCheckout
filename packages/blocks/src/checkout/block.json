{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/checkout",
  "title": "Checkout",
  "category": "yaycheckout",
  "description": "Root container for a YayCheckout checkout layout.",
  "textdomain": "yaycheckout",
  "attributes": {
    "lock": {
      "type": "object",
      "default": { "remove": true }
    }
  },
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
