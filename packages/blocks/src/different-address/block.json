{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/different-address",
  "title": "Different address",
  "category": "yaycheckout",
  "description": "Lets shoppers use a different billing and shipping address. WooCommerce's Shipping destination setting decides which address is the main one.",
  "textdomain": "yaycheckout",
  "keywords": [ "billing", "shipping", "same address", "ship to" ],
  "example": {
    "attributes": {
      "shipLabel": "Ship to a different address?"
    }
  },
  "ancestor": [ "yaycheckout/checkout" ],
  "attributes": {
    "shipLabel": {
      "type": "string",
      "default": ""
    },
    "sameLabel": {
      "type": "string",
      "default": ""
    },
    "ticked": {
      "type": "string",
      "default": "different",
      "enum": [ "different", "same" ]
    },
    "sameShipLabel": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false,
    "color": {
      "text": true,
      "background": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "viewScript": "yaycheckout-different-address",
  "render": "file:./render.php"
}
