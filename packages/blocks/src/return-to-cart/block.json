{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/return-to-cart",
  "title": "Return to Cart Button",
  "category": "yaycheckout",
  "description": "Links to the cart. Shows on every step. Place it anywhere in the layout.",
  "textdomain": "yaycheckout",
  "keywords": [ "cart", "return", "back" ],
  "example": {
    "attributes": {
      "buttonText": "Return to cart"
    }
  },
  "attributes": {
    "buttonText": {
      "type": "string",
      "default": ""
    },
    "arrow": {
      "type": "string",
      "default": "chevron",
      "enum": [ "none", "arrow", "chevron" ]
    }
  },
  "supports": {
    "html": false,
    "reusable": false
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
