{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/order-summary-items",
  "title": "Order Summary Items",
  "category": "yaycheckout",
  "description": "Cart line items. WooCommerce refreshes them when the order updates.",
  "textdomain": "yaycheckout",
  "ancestor": [ "yaycheckout/order-summary" ],
  "attributes": {
    "showLabels": {
      "type": "boolean",
      "default": true
    },
    "productLabel": {
      "type": "string"
    },
    "subtotalLabel": {
      "type": "string"
    },
    "showThumbnails": {
      "type": "boolean",
      "default": true
    },
    "itemData": {
      "type": "string",
      "enum": [ "list", "inline", "hidden" ],
      "default": "inline"
    },
    "showSku": {
      "type": "boolean",
      "default": false
    },
    "showUnitPrice": {
      "type": "boolean",
      "default": false
    },
    "showShortDescription": {
      "type": "boolean",
      "default": false
    },
    "quantityDisplay": {
      "type": "string",
      "enum": [ "inline", "badge" ],
      "default": "inline"
    },
    "showStepper": {
      "type": "boolean",
      "default": false
    },
    "badgeBackgroundColor": {
      "type": "string",
      "default": ""
    },
    "badgeTextColor": {
      "type": "string",
      "default": ""
    },
    "badgeSize": {
      "type": "number"
    }
  },
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false,
    "color": {
      "text": true,
      "background": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "__experimentalFontFamily": true,
      "__experimentalFontStyle": true,
      "__experimentalFontWeight": true,
      "__experimentalLetterSpacing": true,
      "__experimentalTextDecoration": true,
      "__experimentalTextTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "viewScript": [ "yaycheckout-order-summary-items" ],
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
