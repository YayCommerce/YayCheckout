{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/order-summary-items",
  "title": "Order Summary Items",
  "category": "yaycheckout",
  "description": "Cart line items. WooCommerce refreshes them when the order updates.",
  "textdomain": "yaycheckout",
  "ancestor": [ "yaycheckout/order-summary" ],
  "attributes": {
    "showLabels": {
      "type": "boolean",
      "default": true
    },
    "productLabel": {
      "type": "string"
    },
    "subtotalLabel": {
      "type": "string"
    },
    "showThumbnails": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
