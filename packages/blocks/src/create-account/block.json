{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/create-account",
  "title": "Create account",
  "category": "yaycheckout",
  "description": "Lets a guest create an account at checkout, following WooCommerce's account settings.",
  "textdomain": "yaycheckout",
  "keywords": [ "account", "register", "signup", "password" ],
  "example": {
    "attributes": {
      "checkboxLabel": "Create an account?"
    }
  },
  "ancestor": [ "yaycheckout/checkout" ],
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "checkboxLabel": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "yaycheckoutWatchable": true,
    "multiple": false,
    "reusable": false,
    "color": {
      "text": true,
      "background": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
