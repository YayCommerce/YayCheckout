{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/place-order",
  "title": "Place Order",
  "category": "yaycheckout",
  "description": "Submit button for placing the order.",
  "textdomain": "yaycheckout",
  "keywords": [ "submit", "buy" ],
  "example": {},
  "ancestor": [ "yaycheckout/checkout" ],
  "attributes": {
    "buttonText": {
      "type": "string"
    }
  },
  "variations": [
    {
      "name": "place-order",
      "title": "Place Order",
      "description": "Submit button for placing the order.",
      "isDefault": true,
      "scope": [ "inserter" ],
      "attributes": {
        "style": {
          "typography": {
            "textAlign": "center"
          }
        }
      }
    }
  ],
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false,
    "align": [
      "left",
      "center",
      "right"
    ],
    "color": {
      "gradients": true,
      "__experimentalDefaultControls": {
        "background": true,
        "text": true
      }
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "textAlign": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalTextTransform": true,
      "__experimentalTextDecoration": true,
      "__experimentalLetterSpacing": true,
      "__experimentalWritingMode": true,
      "__experimentalDefaultControls": {
        "fontSize": true
      }
    },
    "spacing": {
      "margin": [ "top", "bottom" ],
      "padding": [ "horizontal", "vertical" ],
      "__experimentalDefaultControls": {
        "margin": true,
        "padding": true
      }
    },
    "dimensions": {
      "width": true,
      "__experimentalDefaultControls": {
        "width": true
      }
    },
    "shadow": true,
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true,
      "__experimentalDefaultControls": {
        "color": true,
        "radius": true,
        "style": true,
        "width": true
      }
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php",
  "style": "file:./style-index.css"
}
