{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/place-order",
  "title": "Place Order",
  "category": "yaycheckout",
  "description": "Submit button for placing the order.",
  "textdomain": "yaycheckout",
  "keywords": [ "submit", "buy" ],
  "example": {},
  "ancestor": [ "yaycheckout/checkout" ],
