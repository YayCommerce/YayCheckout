{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/step-button",
  "title": "Step Button",
  "category": "yaycheckout",
  "description": "Validates the open checkout step and opens the next one. Place it anywhere inside Checkout.",
  "textdomain": "yaycheckout",
  "keywords": [ "continue", "next" ],
  "example": {
    "attributes": {
      "buttonText": "Continue"
    }
  },
  "ancestor": [ "yaycheckout/checkout" ],
  "attributes": {
    "buttonText": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "reusable": false
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
