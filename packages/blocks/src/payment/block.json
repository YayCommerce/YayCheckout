{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/payment",
  "title": "Payment",
  "category": "yaycheckout",
  "description": "Payment method list for classic checkout.",
  "textdomain": "yaycheckout",
  "keywords": [ "gateway", "card" ],
  "example": {},
  "ancestor": [ "yaycheckout/checkout" ],
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "label": {
      "type": "string",
      "default": "Payment"
    }
  },
  "supports": {
    "html": false,
    "yaycheckoutWatchable": true,
    "multiple": false,
    "reusable": false
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
