{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/payment",
  "title": "Payment",
  "category": "yaycheckout",
  "description": "Payment method list for classic checkout.",
  "textdomain": "yaycheckout",
  "keywords": [ "gateway", "card" ],
  "example": {},
  "ancestor": [ "yaycheckout/checkout" ],
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "label": {
      "type": "string",
      "default": "Payment"
    },
    "showTitle": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "layout": {
      "type": "string",
      "default": "joined"
    },
    "style": {
      "type": "object",
      "default": {}
    }
  },
  "supports": {
    "html": false,
    "yaycheckoutWatchable": true,
    "multiple": false,
    "reusable": false,
    "color": {
      "text": true,
      "background": false,
      "__experimentalSkipSerialization": true,
      "__experimentalDefaultControls": {
        "text": false
      }
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "viewScript": "file:./view.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
