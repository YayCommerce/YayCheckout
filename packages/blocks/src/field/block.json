{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/field",
  "title": "Field",
  "category": "yaycheckout",
  "description": "A checkout form field. Only insertable inside Billing or Shipping.",
  "textdomain": "yaycheckout",
  "keywords": [ "input", "form" ],
  "example": {
    "attributes": {
      "fieldKey": "billing_first_name",
      "label": "First name"
    }
  },
  "ancestor": [ "yaycheckout/billing", "yaycheckout/shipping" ],
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "fieldKey": {
      "type": "string",
      "default": ""
    },
    "type": {
      "type": "string",
      "enum": [ "text", "email", "tel", "select", "country", "state", "textarea", "checkbox", "password", "hidden" ],
      "default": "text"
    },
    "label": {
      "type": "string",
      "default": ""
    },
    "placeholder": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "requiredMark": {
      "type": "string",
      "default": ""
    },
    "optionalText": {
      "type": "string",
      "default": ""
    },
    "autocomplete": {
      "type": "string",
      "default": ""
    },
    "validate": {
      "type": "array",
      "default": []
    },
    "width": {
      "type": "string",
      "enum": [ "full", "half" ],
      "default": "full"
    },
    "disclosure": {
      "type": "string",
      "enum": [ "none", "link", "collapsible", "checkbox" ]
    },
    "disclosureText": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "yaycheckoutWatchable": true,
    "reusable": false,
    "color": {
      "text": true,
      "background": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "__experimentalFontFamily": true,
      "__experimentalFontStyle": true,
      "__experimentalFontWeight": true,
      "__experimentalLetterSpacing": true,
      "__experimentalTextDecoration": true,
      "__experimentalTextTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}
