{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/login",
  "title": "Login",
  "category": "yaycheckout",
  "description": "A reminder so a returning customer can log in during checkout.",
  "textdomain": "yaycheckout",
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "text": {
      "type": "string",
      "default": "Returning customers? Log in"
    },
    "linkText": {
      "type": "string",
      "default": "Log in"
    },
    "behavior": {
      "type": "string",
      "enum": [ "page", "modal" ],
      "default": "modal"
    }
  },
  "supports": {
    "html": false,
    "yaycheckoutWatchable": true,
    "multiple": false,
    "reusable": false,
    "color": {
      "text": true,
      "background": true,
      "link": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "__experimentalFontFamily": true,
      "__experimentalFontStyle": true,
      "__experimentalFontWeight": true,
      "__experimentalLetterSpacing": true,
      "__experimentalTextDecoration": true,
      "__experimentalTextTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
