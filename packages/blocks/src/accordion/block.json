{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/accordion",
  "title": "Steps",
  "category": "yaycheckout",
  "description": "Checkout steps on one page. The first step is open; later steps stay closed until Continue.",
  "textdomain": "yaycheckout",
  "parent": [ "yaycheckout/checkout" ],
  "attributes": {
    "layout": {
      "type": "string",
      "default": "list",
      "enum": [ "list", "single" ]
    }
  },
  "supports": {
    "html": false,
    "reusable": false
  },
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
