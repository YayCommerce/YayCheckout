{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/thank-you-text",
  "title": "Thank You Text",
  "category": "yaycheckout",
  "description": "A decorative \"Thank you\" for the thank-you page, in one of several styles.",
  "textdomain": "yaycheckout",
  "keywords": [ "thank you", "order", "heading" ],
  "example": {},
  "attributes": {
    "variant": {
      "type": "string",
      "enum": [ "1a", "1b", "1c", "1d", "1e", "1f", "1g", "1h", "1i", "1j", "2a", "2b", "2c", "2d", "2e", "2f", "2g", "2h", "2i", "2j", "2k", "2l", "3a", "3b", "3c", "3d", "3e", "3f", "3g", "3h" ],
      "default": "1e"
    },
    "useThemeColors": {
      "type": "boolean",
      "default": false
    },
    "mainColor": {
      "type": "string",
      "default": ""
    },
    "secondaryColor": {
      "type": "string",
      "default": ""
    },
    "maxWidth": {
      "type": "number"
    },
    "alignment": {
      "type": "string",
      "enum": [ "left", "center", "right" ],
      "default": "center"
    }
  },
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
