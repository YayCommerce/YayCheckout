{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/save-pdf-button",
  "title": "Save as PDF Button",
  "category": "yaycheckout",
  "description": "On the thank-you page, opens the browser's print dialog with a summary of the order, which the shopper can save as a PDF. Only the sections turned on here are printed, never the page's other blocks.",
  "textdomain": "yaycheckout",
  "keywords": [
    "thank you",
    "pdf",
    "print",
    "download",
    "save"
  ],
  "example": {
    "attributes": {
      "buttonText": "Save as PDF"
    }
  },
  "attributes": {
    "buttonText": {
      "type": "string",
      "default": ""
    },
    "showLogo": {
      "type": "boolean",
      "default": true
    },
    "showOverview": {
      "type": "boolean",
      "default": true
    },
    "showPaymentInstructions": {
      "type": "boolean",
      "default": true
    },
    "showItems": {
      "type": "boolean",
      "default": true
    },
    "showAddresses": {
      "type": "boolean",
      "default": true
    },
    "showCustomerNote": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false,
    "align": [
      "left",
      "center",
      "right"
    ],
    "color": {
      "gradients": true,
      "__experimentalDefaultControls": {
        "background": true,
        "text": true
      }
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalTextTransform": true,
      "__experimentalTextDecoration": true,
      "__experimentalLetterSpacing": true,
      "__experimentalDefaultControls": {
        "fontSize": true
      }
    },
    "spacing": {
      "margin": [
        "top",
        "bottom"
      ],
      "padding": [
        "horizontal",
        "vertical"
      ],
      "__experimentalDefaultControls": {
        "margin": true,
        "padding": true
      }
    },
    "dimensions": {
      "width": true
    },
    "shadow": true,
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
