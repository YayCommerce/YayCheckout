{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/order-details",
  "title": "Order Details",
  "category": "yaycheckout",
  "description": "WooCommerce's order details table on the thank-you page: line items, totals, downloads and plugin output on its hooks, with optional product thumbnails, a minimal table style and a highlighted total.",
  "textdomain": "yaycheckout",
  "keywords": [ "thank you", "order", "receipt", "items" ],
  "example": {},
  "attributes": {
    "showTitle": {
      "type": "boolean",
      "default": true
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "productLabel": {
      "type": "string",
      "default": ""
    },
    "totalLabel": {
      "type": "string",
      "default": ""
    },
    "subtotalLabel": {
      "type": "string",
      "default": ""
    },
    "shippingLabel": {
      "type": "string",
      "default": ""
    },
    "paymentMethodLabel": {
      "type": "string",
      "default": ""
    },
    "orderTotalLabel": {
      "type": "string",
      "default": ""
    },
    "showThumbnails": {
      "type": "boolean",
      "default": false
    },
    "thumbnailRatio": {
      "type": "string",
      "enum": [ "square", "portrait", "landscape", "original" ],
      "default": "square"
    },
    "thumbnailSize": {
      "type": "number"
    },
    "thumbnailRadius": {
      "type": "number"
    },
    "tableStyle": {
      "type": "string",
      "enum": [ "boxed", "minimal" ],
      "default": "boxed"
    },
    "showDivider": {
      "type": "boolean",
      "default": false
    },
    "dividerColor": {
      "type": "string",
      "default": ""
    },
    "totalLast": {
      "type": "boolean",
      "default": false
    },
    "totalColor": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false,
    "color": {
      "text": true,
      "background": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "__experimentalFontFamily": true,
      "__experimentalFontStyle": true,
      "__experimentalFontWeight": true,
      "__experimentalLetterSpacing": true,
      "__experimentalTextDecoration": true,
      "__experimentalTextTransform": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
