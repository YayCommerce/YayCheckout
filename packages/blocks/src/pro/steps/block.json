{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/steps",
  "title": "Steps",
  "category": "yaycheckout",
  "description": "Checkout steps on one page. The first step is open; later steps stay closed until Continue.",
  "textdomain": "yaycheckout",
  "keywords": [ "accordion", "multi-step", "wizard" ],
  "example": {
    "innerBlocks": [
      {
        "name": "yaycheckout/step",
        "attributes": {
          "title": "Information"
        },
        "innerBlocks": [
          {
            "name": "yaycheckout/step-button",
            "attributes": {
              "buttonText": "Continue"
            }
          }
        ]
      },
      {
        "name": "yaycheckout/step",
        "attributes": {
          "title": "Payment"
        },
        "innerBlocks": [
          {
            "name": "yaycheckout/step-button",
            "attributes": {
              "buttonText": "Continue"
            }
          }
        ]
      }
    ]
  },
  "ancestor": [ "yaycheckout/checkout" ],
  "allowedBlocks": [ "yaycheckout/step" ],
  "attributes": {
    "layout": {
      "type": "string",
      "default": "accordion",
      "enum": [ "accordion", "one-at-a-time", "timeline" ]
    },
    "showHeadings": {
      "type": "boolean",
      "default": true
    }
  },
  "providesContext": {
    "yaycheckout/showHeadings": "showHeadings"
  },
  "supports": {
    "html": false,
    "reusable": false,
    "color": {
      "text": true,
      "background": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    }
  },
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
