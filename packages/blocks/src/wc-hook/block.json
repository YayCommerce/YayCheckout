{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/wc-hook",
  "title": "WooCommerce Hook",
  "category": "yaycheckout",
  "description": "Prints what plugins add on a WooCommerce checkout hook, here instead of inside another block.",
  "textdomain": "yaycheckout",
  "keywords": [ "hook", "plugin", "action" ],
  "example": {
    "attributes": {
      "hook": "woocommerce_review_order_before_submit"
    }
  },
  "ancestor": [ "yaycheckout/checkout" ],
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "hook": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "yaycheckoutWatchable": true,
    "reusable": false,
    "color": {
      "text": true,
      "background": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
