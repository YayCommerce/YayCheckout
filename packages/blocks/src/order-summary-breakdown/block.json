{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/order-summary-breakdown",
  "title": "Order Summary Breakdown",
  "category": "yaycheckout",
  "description": "Subtotal, discounts, shipping, fees and taxes: the lines that add up to the order total. Updates as the cart changes.",
  "keywords": [ "subtotal", "discount", "coupon", "shipping", "fee", "tax", "totals" ],
  "textdomain": "yaycheckout",
  "ancestor": [ "yaycheckout/order-summary" ],
  "attributes": {
    "showSubtotal": {
      "type": "boolean",
      "default": true
    },
    "subtotalLabel": {
      "type": "string"
    }
  },
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false,
    "color": {
      "text": true,
      "background": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
