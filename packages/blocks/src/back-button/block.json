{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/back-button",
  "title": "Previous Step Button",
  "category": "yaycheckout",
  "description": "Opens the previous checkout step. On the first step it returns to the cart or hides. Place it anywhere in the layout.",
  "textdomain": "yaycheckout",
  "keywords": [ "previous", "return", "back", "step" ],
  "example": {
    "attributes": {
      "buttonText": "Back"
    }
  },
  "attributes": {
    "buttonText": {
      "type": "string",
      "default": ""
    },
    "firstStep": {
      "type": "string",
      "default": "cart",
      "enum": [ "cart", "hide" ]
    },
    "cartText": {
      "type": "string",
      "default": ""
    },
    "arrow": {
      "type": "string",
      "default": "none",
      "enum": [ "none", "arrow", "chevron" ]
    }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "color": {
      "text": true,
      "background": true,
      "__experimentalDefaultControls": {
        "background": true,
        "text": true
      }
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "__experimentalDefaultControls": {
        "padding": true
      }
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true,
      "__experimentalDefaultControls": {
        "color": true,
        "radius": true,
        "style": true,
        "width": true
      }
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
