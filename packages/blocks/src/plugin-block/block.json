{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/plugin-block",
  "title": "Plugin block",
  "category": "yaycheckout-plugins",
  "description": "A spot for another Yay plugin's block or its shortcode.",
  "textdomain": "yaycheckout",
  "attributes": {
    "target": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "inserter": false,
    "spacing": {
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php"
}
