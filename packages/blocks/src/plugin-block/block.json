{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/plugin-block",
  "title": "Plugin block",
  "category": "yaycheckout-plugins",
  "description": "A spot that another Yay plugin's shortcode fills.",
  "textdomain": "yaycheckout",
  "attributes": {
    "target": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "inserter": false,
    "color": {
      "text": false,
      "background": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php"
}
