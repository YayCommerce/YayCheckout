{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/order-summary-toggle",
  "title": "Summary Toggle",
  "category": "yaycheckout",
  "description": "Opens and closes the Order Summary while it is collapsible.",
  "textdomain": "yaycheckout",
  "keywords": [ "collapse", "expand", "cart" ],
  "attributes": {
    "showChevron": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "color": {
      "text": true,
      "background": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "layout": {
      "default": {
        "type": "flex",
        "flexWrap": "nowrap",
        "verticalAlignment": "center"
      },
      "allowSwitching": false
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
