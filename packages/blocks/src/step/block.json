{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/step",
  "title": "Step",
  "category": "yaycheckout",
  "description": "One checkout step. Holds the sections of that step.",
  "textdomain": "yaycheckout",
  "keywords": [ "accordion", "section" ],
  "example": {
    "attributes": {
      "title": "Information"
    },
    "innerBlocks": [
      {
        "name": "yaycheckout/step-button",
        "attributes": {
          "buttonText": "Continue"
        }
      }
    ]
  },
  "parent": [ "yaycheckout/steps" ],
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "reusable": false
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
