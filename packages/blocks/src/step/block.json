{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "yaycheckout/step",
  "title": "Step",
  "category": "yaycheckout",
  "description": "One checkout step. Holds the sections of that step.",
  "textdomain": "yaycheckout",
  "keywords": [ "accordion", "section" ],
  "example": {
    "attributes": {
      "title": "Information"
    },
    "innerBlocks": [
      {
        "name": "yaycheckout/step-button",
        "attributes": {
          "buttonText": "Continue"
        }
      }
    ]
  },
  "parent": [ "yaycheckout/steps" ],
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "color": {
      "text": true,
      "background": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "__experimentalDefaultControls": {
        "margin": true,
        "padding": true
      }
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true,
      "__experimentalDefaultControls": {
        "color": true,
        "radius": true,
        "style": true,
        "width": true
      }
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}
