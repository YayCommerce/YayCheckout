{
  "core": null,
  "phpVersion": "8.2",
  "plugins": [
    "https://downloads.wordpress.org/plugin/woocommerce.zip"
  ],
  "mappings": {
    "wp-content/plugins/yaycheckout": "../.."
  },
  "port": 9680,
  "testsEnvironment": true,
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false,
    "SCRIPT_DEBUG": true,
    "YAYCHECKOUT_IS_DEVELOPMENT": false,
    "DISABLE_WP_CRON": true,
    "WP_HTTP_BLOCK_EXTERNAL": true
  },
  "lifecycleScripts": {
    "afterStart": "bash ./bin/setup-env.sh",
    "afterClean": "bash ./bin/setup-env.sh"
  }
}
