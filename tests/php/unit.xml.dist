<?xml version="1.0"?>
<!-- Unit tests: plain PHP, WordPress functions stubbed with Brain Monkey. Run: yayh test run unit -->
<phpunit
	bootstrap="unit/bootstrap.php"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	failOnRisky="true"
	failOnWarning="true">
	<testsuites>
		<testsuite name="unit">
			<directory suffix="Test.php">unit</directory>
		</testsuite>
	</testsuites>
</phpunit>
